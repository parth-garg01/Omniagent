# Copy to .env. Never commit real keys.
NOVA_DATABASE_URL=sqlite:///./nova.db
NOVA_LLM_PROVIDER=fake            # fake | anthropic
NOVA_LLM_FALLBACK_PROVIDER=       # optional; used only on timeout/rate-limit/unavailable
NOVA_ANTHROPIC_API_KEY=
NOVA_ANTHROPIC_MODEL=claude-haiku-5-5
NOVA_SESSION_TTL_HOURS=24
NOVA_MAX_UPLOAD_BYTES=2000000
NOVA_COOKIE_SECURE=false
NOVA_ALLOW_REGISTRATION=true       # set false for any shared/public deployment
NOVA_DEMO_PASSWORD=                # set to a strong value for any shared/public deployment
