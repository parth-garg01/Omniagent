# Copy to .env. Never commit real keys.
NOVA_DATABASE_URL=sqlite:///./nova.db
NOVA_LLM_PROVIDER=fake            # fake | grok
NOVA_LLM_FALLBACK_PROVIDER=       # optional; used only on timeout/rate-limit/unavailable
NOVA_GROK_API_KEY=
NOVA_GROK_MODEL=grok-4        # assumption: set to a model your xAI account offers
NOVA_GROK_BASE_URL=https://api.x.ai/v1
NOVA_SESSION_TTL_HOURS=24
NOVA_MAX_UPLOAD_BYTES=2000000
NOVA_COOKIE_SECURE=false
